/**
 * 这是 TypeScript 的 Project References（项目引用） 模式，
 * @files 它仅仅作为一个“入口”或“聚合器”，把具体的编译任务分发给 references 中定义的子项目
 * @references 引用了两个独立的子配置文件
 * @tsconfig.node.json 用于编译 Node.js 相关的代码，例如服务器端渲染（SSR）
 * @tsconfig.app.json 用于编译 Vue 应用相关的代码，例如客户端渲染（CSR）
 */

{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
